-- UTILITIES
local function safeDestroy(obj)
    if obj and obj.Parent then
        pcall(function() obj:Destroy() end)
    end
end

local function getHRP(char)
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
end

local function isEXE(model)
    if not model then return false end
    for _, desc in pairs(model:GetDescendants()) do
        if desc:IsA("BasePart") then
            local name = desc.Name
            if name == "Rage" or string.lower(name) == "upperjaggedteeth" then
                return true
            end
            if (name == "Body_Original" or name == "Lowerbody_Composited") then
                local parent = desc.Parent
                if parent and parent.Name == "InitialPoses" then
                    return true
                end
            end
        end
    end
    return false
end

-- JUMP MAINTENANCE
task.spawn(function()
    while task.wait(0.3) do
        if state.panelActive then
            pcall(function()
                StarterGui:SetCore("JumpButtonEnabled", true)
            end)
        end
    end
end)

local function setupJumpFix(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end
    local conn = RunService.RenderStepped:Connect(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
        hum.AutoJumpEnabled = false
    end)
    char.AncestryChanged:Connect(function()
        if not char:IsDescendantOf(game) then
            conn:Disconnect()
        end
    end)
end

-- ESP SYSTEM
local function clearHighlight(char)
    if not char then return end
    local data = highlights[char]
    if data then
        for _, obj in pairs(data) do
            safeDestroy(obj)
        end
        highlights[char] = nil
    end
end

local function clearAllHighlights()
    for char, _ in pairs(highlights) do
        clearHighlight(char)
    end
    highlights = {}
end

local function createESP(char)
    clearHighlight(char)
    if not char or not char:IsA("Model") then return end
    
    local hrp = getHRP(char)
    if not hrp then return end
    
    local isSpecial = isEXE(char)
    local playerName = char.Name
    
    local highlight = Instance.new("Highlight")
    highlight.Adornee = char
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.FillColor = isSpecial and Color3.fromRGB(220, 50, 50) or Color3.fromRGB(50, 150, 255)
    highlight.OutlineColor = isSpecial and Color3.fromRGB(255, 100, 100) or Color3.fromRGB(100, 200, 255)
    highlight.Parent = char
    
    local billboard = Instance.new("BillboardGui")
    billboard.Adornee = hrp
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.new(0, 200, 0, 80)
    billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    billboard.Parent = char
    
    local nameLabel = Instance.new("TextLabel", billboard)
    nameLabel.Size = UDim2.new(1, 0, 0.4, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = playerName
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextScaled = true
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextStrokeTransparency = 0.5
    
    if isSpecial then
        local exeLabel = Instance.new("TextLabel", billboard)
        exeLabel.Size = UDim2.new(1, 0, 0.6, 0)
        exeLabel.Position = UDim2.new(0, 0, 0.4, 0)
        exeLabel.BackgroundTransparency = 1
        exeLabel.Text = "[EXE]"
        exeLabel.Font = Enum.Font.SourceSansBold
        exeLabel.TextScaled = true
        exeLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
        exeLabel.TextStrokeTransparency = 0
        exeLabel.TextStrokeColor3 = Color3.fromRGB(120, 0, 0)
    end
    
    highlights[char] = {highlight, billboard}
end

-- TRACER SYSTEM
local function clearTracer(char)
    if not char then return end
    local data = tracers[char]
    if data then
        for _, obj in pairs(data) do
            safeDestroy(obj)
        end
        tracers[char] = nil
    end
end

local function clearAllTracers()
    for char, _ in pairs(tracers) do
        clearTracer(char)
    end
    tracers = {}
end

local function createTracer(char)
    clearTracer(char)
    if not char or not char:IsA("Model") then return end
    
    local hrp = getHRP(char)
    if not hrp then return end
    
    local lpChar = LocalPlayer.Character
    local lpHRP = lpChar and getHRP(lpChar)
    if not lpHRP then return end
    
    local att0 = Instance.new("Attachment", lpHRP)
    local att1 = Instance.new("Attachment", hrp)
    
    local beam = Instance.new("Beam")
    beam.Attachment0 = att0
    beam.Attachment1 = att1
    beam.FaceCamera = true
    beam.Width0 = CONFIG.BEAM_WIDTH
    beam.Width1 = CONFIG.BEAM_WIDTH
    
    local color = isEXE(char) and Color3.fromRGB(255, 60, 60) or Color3.fromRGB(100, 180, 255)
    beam.Color = ColorSequence.new(color)
    beam.Transparency = NumberSequence.new(0.4)
    beam.Parent = lpHRP
    
    tracers[char] = {att0, att1, beam}
end

-- SCAN SYSTEM
local function evaluateCharacter(char)
    if not char or char == LocalPlayer.Character then return end
    if not char:IsA("Model") then return end
    
    if state.espEnabled then
        createESP(char)
    else
        clearHighlight(char)
    end
    
    if state.tracersEnabled then
        createTracer(char)
    else
        clearTracer(char)
    end
end

local function scanLoop()
    while state.panelActive do
        task.wait(CONFIG.SCAN_RATE)
        
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                evaluateCharacter(player.Character)
            end
        end
        
        local playersFolder = Workspace:FindFirstChild("Players")
        if playersFolder then
            for _, model in pairs(playersFolder:GetChildren()) do
                if model:IsA("Model") then
                    evaluateCharacter(model)
                end
            end
        end
    end
end

-- MOVEMENT SYSTEM
local function startMovement()
    if connections.movement then return end
    connections.movement = RunService.RenderStepped:Connect(function(dt)
        if not state.panelActive then return end
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = getHRP(char)
        if hum and hrp then
            local dir = hum.MoveDirection
            if dir.Magnitude > 0 then
                hrp.CFrame = hrp.CFrame + dir * (state.speed * dt)
            end
        end
    end)
end

local function stopMovement()
    if connections.movement then
        connections.movement:Disconnect()
        connections.movement = nil
    end
end

-- AUTO HEAL SYSTEM
local function startAutoHeal()
    if connections.autoHeal then return end
    connections.autoHeal = RunService.Heartbeat:Connect(function()
        if not state.autoHealEnabled then return end
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 and hum.Health < state.healThreshold then
            hum.Health = math.min(hum.MaxHealth, hum.Health + CONFIG.HEAL_RATE)
        end
    end)
end

local function stopAutoHeal()
    if connections.autoHeal then
        connections.autoHeal:Disconnect()
        connections.autoHeal = nil
    end
end

-- SPAM JUMP SYSTEM
local function startSpamJump()
    if connections.spamJump then return end
    connections.spamJump = RunService.Heartbeat:Connect(function()
        if not state.spamJumpEnabled or not state.spaceHeld then return end
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end)
end

local function stopSpamJump()
    if connections.spamJump then
        connections.spamJump:Disconnect()
        connections.spamJump = nil
    end
end

