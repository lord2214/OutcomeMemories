-- BUTTON EVENTS
applyBtn.MouseButton1Click:Connect(function()
    if not state.panelActive then return end
    local speed = tonumber(speedBox.Text)
    if speed and speed > 0 then
        state.walkSpeed = speed
        state.speed = state.running and (speed * CONFIG.RUN_MULTIPLIER) or speed
    end
    local heal = tonumber(healBox.Text)
    if heal and heal > 0 and heal <= 100 then
        state.healThreshold = heal
    end
end)

espBtn.MouseButton1Click:Connect(function()
    if not state.panelActive then return end
    state.espEnabled = not state.espEnabled
    espBtn.Text = state.espEnabled and "ESP: ON" or "ESP: OFF"
    espBtn.BackgroundColor3 = state.espEnabled and Color3.fromRGB(40, 120, 40) or Color3.fromRGB(120, 40, 40)
    if not state.espEnabled then clearAllHighlights() end
end)

tracersBtn.MouseButton1Click:Connect(function()
    if not state.panelActive then return end
    state.tracersEnabled = not state.tracersEnabled
    tracersBtn.Text = state.tracersEnabled and "Tracers: ON" or "Tracers: OFF"
    tracersBtn.BackgroundColor3 = state.tracersEnabled and Color3.fromRGB(40, 120, 40) or Color3.fromRGB(120, 40, 40)
    if not state.tracersEnabled then clearAllTracers() end
end)

jumpBtn.MouseButton1Click:Connect(function()
    if not state.panelActive then return end
    state.spamJumpEnabled = not state.spamJumpEnabled
    jumpBtn.Text = state.spamJumpEnabled and "Spam Jump: ON" or "Spam Jump: OFF"
    jumpBtn.BackgroundColor3 = state.spamJumpEnabled and Color3.fromRGB(40, 120, 40) or Color3.fromRGB(120, 40, 40)
    if state.spamJumpEnabled then startSpamJump() else stopSpamJump() end
end)

healBtn.MouseButton1Click:Connect(function()
    if not state.panelActive then return end
    state.autoHealEnabled = not state.autoHealEnabled
    healBtn.Text = state.autoHealEnabled and "Auto Heal: ON" or "Auto Heal: OFF"
    healBtn.BackgroundColor3 = state.autoHealEnabled and Color3.fromRGB(40, 120, 40) or Color3.fromRGB(120, 40, 40)
    if state.autoHealEnabled then startAutoHeal() else stopAutoHeal() end
end)

closeBtn.MouseButton1Click:Connect(function()
    state.panelActive = not state.panelActive
    frame.Visible = state.panelActive
    
    if not state.panelActive then
        state.espEnabled = false
        state.tracersEnabled = false
        state.spamJumpEnabled = false
        state.autoHealEnabled = false
        clearAllHighlights()
        clearAllTracers()
        stopMovement()
        stopAutoHeal()
        stopSpamJump()
    else
        startMovement()
        if state.autoHealEnabled then startAutoHeal() end
        if state.spamJumpEnabled then startSpamJump() end
        connections.scanTask = task.spawn(scanLoop)
    end
    
    closeBtn.Text = state.panelActive and "Close" or "Open"
end)

-- INPUT HANDLING
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe or not state.panelActive then return end
    
    if input.KeyCode == Enum.KeyCode.P then
        state.guiVisible = not state.guiVisible
        frame.Visible = state.guiVisible and state.panelActive
    elseif input.KeyCode == Enum.KeyCode.LeftShift then
        state.running = true
        state.speed = state.walkSpeed * CONFIG.RUN_MULTIPLIER
    elseif input.KeyCode == Enum.KeyCode.Space then
        state.spaceHeld = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.LeftShift then
        state.running = false
        state.speed = state.walkSpeed
    elseif input.KeyCode == Enum.KeyCode.Space then
        state.spaceHeld = false
    end
end)

-- PLAYER EVENTS
for _, player in pairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        player.CharacterAdded:Connect(function(char)
            task.wait(0.1)
            evaluateCharacter(char)
        end)
    end
end

Players.PlayerAdded:Connect(function(player)
    if player == LocalPlayer then return end
    player.CharacterAdded:Connect(function(char)
        task.wait(0.1)
        evaluateCharacter(char)
    end)
end)

Players.PlayerRemoving:Connect(function(player)
    if player.Character then
        clearHighlight(player.Character)
        clearTracer(player.Character)
    end
end)

local playersFolder = Workspace:FindFirstChild("Players")
if playersFolder then
    playersFolder.ChildAdded:Connect(function(model)
        task.wait(0.1)
        if model:IsA("Model") then
            evaluateCharacter(model)
        end
    end)
end

-- CHARACTER RESPAWN
