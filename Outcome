--// ARMAZENAMENTO DE HIGHLIGHTS //--
local highlights = {}

--// FUNÇÕES DE LIMPEZA //--
local function clearHighlightForCharacter(char)
    if not char then return end
    local existing = highlights[char]
    if existing then
        for _, obj in pairs(existing) do
            if obj and obj.Parent then 
                pcall(function() obj:Destroy() end)
            end
        end
        highlights[char] = nil
    end
end

local function clearAllHighlights()
    for char, _ in pairs(highlights) do
        clearHighlightForCharacter(char)
    end
    highlights = {}
end

--// CRIAR HIGHLIGHT //--
local function makeHighlightForCharacter(char, isSpecial)
    clearHighlightForCharacter(char)
    if not char or not char:IsA("Model") then return end
    
    local adornee = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
    if not adornee then return end

    local h = Instance.new("Highlight")
    h.Adornee = char
    h.FillTransparency = 0.6
    h.OutlineTransparency = 0.5
    h.Parent = char

    if isSpecial then
        h.FillColor = Color3.fromRGB(200, 50, 50)
        h.OutlineColor = Color3.fromRGB(255, 100, 100)
    else
        h.FillColor = Color3.fromRGB(50, 100, 200)
        h.OutlineColor = Color3.fromRGB(100, 150, 255)
    end

    local bill = nil
    if isSpecial then
        bill = Instance.new("BillboardGui", char)
        bill.Name = "SpyTag"
        bill.Adornee = adornee
        bill.AlwaysOnTop = true
        bill.Size = UDim2.new(0, 80, 0, 24)
        bill.StudsOffset = Vector3.new(0, 2.5, 0)
        
        local t = Instance.new("TextLabel", bill)
        t.Size = UDim2.new(1, 0, 1, 0)
        t.BackgroundTransparency = 1
        t.TextScaled = true
        t.Text = "[SPY]"
        t.Font = Enum.Font.Arcade
        t.TextColor3 = Color3.fromRGB(255, 80, 80)
    end

    highlights[char] = {h, bill}
end

--// LINE OF SIGHT //--
local function hasLineOfSight(originPos, targetPart)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = {LocalPlayer.Character}
    params.IgnoreWater = true

    local dir = targetPart.Position - originPos
    local res = Workspace:Raycast(originPos, dir, params)
    
    if not res then return true end
    return res.Instance:IsDescendantOf(targetPart.Parent)
end

--// AVALIAR ESPIONAGEM //--
local function evaluateSpyForCharacter(char)
    if not spyEnabled or not panelActive then
        clearHighlightForCharacter(char)
        return
    end
    
    if not char or not char:IsA("Model") or char == LocalPlayer.Character then
        clearHighlightForCharacter(char)
        return
    end

    local allow = char:FindFirstChild("AllowSpy")
    if not allow or not allow.Value then
        clearHighlightForCharacter(char)
        return
    end

    local targetPart = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
    if not targetPart then
        clearHighlightForCharacter(char)
        return
    end

    local maxDist = 80
    if (targetPart.Position - lpHRP.Position).Magnitude > maxDist then
        clearHighlightForCharacter(char)
        return
    end

    if not hasLineOfSight(lpHRP.Position + Vector3.new(0, 1, 0), targetPart) then
        clearHighlightForCharacter(char)
        return
    end

    local isSpecial = false
    local isEXE = char:FindFirstChild("IsEXE")
    if isEXE and isEXE.Value then isSpecial = true end

    makeHighlightForCharacter(char, isSpecial)
end

--// SCAN LOOP //--
local function scanLoop()
    while panelActive and task.wait(0.25) do
        lpChar = LocalPlayer.Character
        if lpChar then
            lpHum = lpChar:FindFirstChildOfClass("Humanoid")
            lpHRP = lpChar:FindFirstChild("HumanoidRootPart") or lpChar.PrimaryPart
        end

        for _, pl in pairs(Players:GetPlayers()) do
            if pl.Character then
                evaluateSpyForCharacter(pl.Character)
            end
        end

        local playersFolder = Workspace:FindFirstChild("Players")
        if playersFolder then
            for _, model in pairs(playersFolder:GetChildren()) do
                if model:IsA("Model") and model ~= lpChar then
                    evaluateSpyForCharacter(model)
                end
            end
        end
    end
end

--// DESATIVAR TUDO //--
local function deactivateAll()
    panelActive = false
    spyEnabled = false
    running = false
    speed = WALK_SPEED
    
    clearAllHighlights()
    
    if movementConnection then
        movementConnection:Disconnect()
        movementConnection = nil
    end
    
    frame.Visible = false
    spyToggle.Text = "👁️ Spy: OFF"
    spyToggle.BackgroundColor3 = Color3.fromRGB(80, 40, 40)
end

--// REATIVAR TUDO //--
local function reactivateAll()
    panelActive = true
    frame.Visible = true
    
    -- Reiniciar movimento
    if not movementConnection then
        movementConnection = RunService.RenderStepped:Connect(function(dt)
            if not panelActive then return end
            local dir = lpHum and lpHum.MoveDirection or Vector3.new()
            if dir.Magnitude > 0 and lpHRP and lpHRP.Parent then
                lpHRP.CFrame = lpHRP.CFrame + dir * (speed * dt)
            end
        end)
    end
    
    -- Reiniciar scan loop
    task.spawn(scanLoop)
end

