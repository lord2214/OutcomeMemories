    if inp.KeyCode == Enum.KeyCode.P then
        guiVisible = not guiVisible
        frame.Visible = guiVisible and panelActive
    end
    
    if inp.KeyCode == Enum.KeyCode.LeftShift then
        running = true
        speed = WALK_SPEED + RUN_EXTRA
    end
end)

UserInputService.InputEnded:Connect(function(inp)
    if inp.KeyCode == Enum.KeyCode.LeftShift then
        running = false
        speed = WALK_SPEED
    end
end)

