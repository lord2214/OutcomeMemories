title.Position = UDim2.new(0,0,0,0)
title.BackgroundTransparency = 1
title.Text = "Spy Panel (safe)"
title.TextScaled = true

local speedBox = Instance.new("TextBox", frame)
speedBox.Size = UDim2.new(0.6,0,0,28)
speedBox.Position = UDim2.new(0.02,0,0.25,0)
speedBox.Text = tostring(WALK_SPEED)
speedBox.ClearTextOnFocus = false

local applyBtn = Instance.new("TextButton", frame)
applyBtn.Size = UDim2.new(0.36,0,0,28)
applyBtn.Position = UDim2.new(0.62,0,0.25,0)
applyBtn.Text = "Aplicar"

local spyToggle = Instance.new("TextButton", frame)
spyToggle.Size = UDim2.new(0.48,0,0,28)
spyToggle.Position = UDim2.new(0.02,0,0.6,0)
spyToggle.Text = "Spy: OFF"
spyToggle.Active = true

local resetBtn = Instance.new("TextButton", frame)
resetBtn.Size = UDim2.new(0.48,0,0,28)
resetBtn.Position = UDim2.new(0.5,0,0.6,0)
resetBtn.Text = "Reset"

local openKey = Enum.KeyCode.P -- tecla pra abrir/fechar GUI
local guiVisible = true

-- jump fix (keeps jump button enabled & disables AutoJump)
task.spawn(function()
	while true do
		StarterGui:SetCore("JumpButtonEnabled", true)
		StarterGui:SetCore("JumpButtonVisible", true)
		task.wait(0.4)
	end
end)

-- apply speed
applyBtn.MouseButton1Click:Connect(function()
	local v = tonumber(speedBox.Text)
	if v and v > 0 then
		WALK_SPEED = v
		speed = WALK_SPEED
		RUN_EXTRA = math.max(1, math.floor(WALK_SPEED*0.15))
	end
end)

-- toggle spy mode (local-only toggle; visibility still depends on server flags & LOS)
local spyEnabled = false
spyToggle.MouseButton1Click:Connect(function()
	spyEnabled = not spyEnabled
	spyToggle.Text = spyEnabled and "Spy: ON" or "Spy: OFF"
end)

-- open/close gui key
UserInputService.InputBegan:Connect(function(inp, gpe)
	if gpe then return end
	if inp.KeyCode == openKey then
		guiVisible = not guiVisible
		frame.Visible = guiVisible
	end
	if inp.KeyCode == Enum.KeyCode.LeftShift then
		running = true
		speed = WALK_SPEED + RUN_EXTRA
	end
end)
UserInputService.InputEnded:Connect(function(inp)
	if inp.KeyCode == Enum.KeyCode.LeftShift then
		running = false
		speed = WALK_SPEED
	end
end)

-- store created highlights to cleanup
local highlights = {} -- key = character, value = {highlight, billboard}

local function clearHighlightForCharacter(char)
	if not char then return end
	local existing = highlights[char]
	if existing then
		for _, obj in pairs(existing) do
			if obj and obj.Parent then obj:Destroy() end
		end
		highlights[char] = nil
	end
end

local function makeHighlightForCharacter(char, isSpecial)
	clearHighlightForCharacter(char)
	if not char or not char:IsA("Model") then return end
	local adornee = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
	if not adornee then return end

	local h = Instance.new("Highlight")
	h.Adornee = char
	h.FillTransparency = 0.6
	h.OutlineTransparency = 0.5
	h.Parent = char

	-- color sensível (apenas visual, sem atravessar paredes)
	if isSpecial then
		h.FillColor = Color3.fromRGB(200,50,50)
		h.OutlineColor = Color3.fromRGB(255,100,100)
	else
		h.FillColor = Color3.fromRGB(50,100,200)
		h.OutlineColor = Color3.fromRGB(100,150,255)
	end

	local bill
	if isSpecial then
		bill = Instance.new("BillboardGui", char)
		bill.Name = "SpyTag"
		bill.Adornee = adornee
		bill.AlwaysOnTop = true
		bill.Size = UDim2.new(0,80,0,24)
		bill.StudsOffset = Vector3.new(0,2.5,0)
		local t = Instance.new("TextLabel", bill)
		t.Size = UDim2.new(1,0,1,0)
		t.BackgroundTransparency = 1
		t.TextScaled = true
		t.Text = "[SPY]"
		t.Font = Enum.Font.Arcade
		t.TextColor3 = Color3.fromRGB(180,60,60)
	end

	highlights[char] = {h, bill}
end

-- line-of-sight check: returns true if there is a direct visible path from origin to targetPart
local function hasLineOfSight(originPos, targetPart)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Blacklist
	-- ignore the target character's parts by not listing them in blacklist; instead blacklist LocalPlayer and other irrelevant things
	params.FilterDescendantsInstances = {LocalPlayer.Character}
	params.IgnoreWater = true

	local dir = targetPart.Position - originPos
	local res = Workspace:Raycast(originPos, dir, params)
	if not res then
		-- nothing hit between origin and target => clear LOS
		return true
	end
	-- if ray hit something, check if that thing is part of targetPart's model
	return res.Instance:IsDescendantOf(targetPart.Parent)
end

-- spy evaluation per character
local function evaluateSpyForCharacter(char)
	if not spyEnabled then
		clearHighlightForCharacter(char)
		return
	end
	if not char or not char:IsA("Model") then return end
	if char == LocalPlayer.Character then
		clearHighlightForCharacter(char)
		return
	end

	-- server must add a BoolValue "AllowSpy" inside Character for authorization
	local allow = char:FindFirstChild("AllowSpy")
	if not allow or not allow.Value then
		clearHighlightForCharacter(char)
		return
	end

	local targetPart = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
	if not targetPart then
		clearHighlightForCharacter(char)
		return
	end

	-- distance check
	local maxDist = 80 -- alcance máximo de espionagem (ajustável)
	if (targetPart.Position - lpHRP.Position).Magnitude > maxDist then
		clearHighlightForCharacter(char)
		return
	end

	-- line-of-sight check
	if not hasLineOfSight(lpHRP.Position + Vector3.new(0,1,0), targetPart) then
		clearHighlightForCharacter(char)
		return
	end

	-- determine if special (server might set an Attribute or special child; aqui apenas checamos por um Bool "IsEXE")
	local isSpecial = false
	local isEXE = char:FindFirstChild("IsEXE")
	if isEXE and isEXE.Value then isSpecial = true end

	-- create highlight
	makeHighlightForCharacter(char, isSpecial)
end

-- scan players/characters periodically and watch for changes (local-only loop)
local function scanLoop()
	while true do
		-- keep local references fresh
		lpChar = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
		lpHum = lpChar:FindFirstChildOfClass("Humanoid")
		lpHRP = lpChar:FindFirstChild("HumanoidRootPart") or lpChar.PrimaryPart

		-- evaluate each player character in workspace (Players' characters or a custom folder)
		for _, pl in pairs(Players:GetPlayers()) do
			local ch = pl.Character
			if ch then
				evaluateSpyForCharacter(ch)
			end
		end

		-- also optional: scan a `Workspace.Players` folder if your game uses it
		local playersFolder = Workspace:FindFirstChild("Players")
		if playersFolder then
			for _, model in pairs(playersFolder:GetChildren()) do
				if model:IsA("Model") and model ~= lpChar then
					evaluateSpyForCharacter(model)
				end
			end
		end

		task.wait(0.25)
	end
end
task.spawn(scanLoop)

-- cleanup/reset
local function resetAll()
	-- remove highlights/billboards
	for char, _ in pairs(highlights) do
		clearHighlightForCharacter(char)
	end
	highlights = {}
	-- reset speeds and flags
	WALK_SPEED = 16
	RUN_EXTRA = 4
	speed = WALK_SPEED
	speedBox.Text = tostring(WALK_SPEED)
	spyEnabled = false
	spyToggle.Text = "Spy: OFF"
	-- remove GUI? (vou deixar apenas resetar valores)
end

resetBtn.MouseButton1Click:Connect(resetAll)

-- movement: apply custom root motion each frame (compact)
RunService.RenderStepped:Connect(function(dt)
	local dir = lpHum and lpHum.MoveDirection or Vector3.new()
	if dir.Magnitude > 0 then
		-- move HRP by dir * speed * dt
		if lpHRP and lpHRP.Parent then
			lpHRP.CFrame = lpHRP.CFrame + dir * (speed * dt)
		end
	end
end)

-- ensure we cleanup highlights when characters die/remove
Players.PlayerRemoving:Connect(function(pl)
	if pl.Character then
		clearHighlightForCharacter(pl.Character)
	end
end)
