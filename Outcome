--[[ Spy-safe Player Toolkit
     LocalScript (colocar em StarterPlayerScripts)
     Requisitos (servidor): colocar um BoolValue chamado "AllowSpy" dentro do Character
     para cada personagem que o servidor autorizar ser "espiado".
--]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local lpChar = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local lpHum = lpChar:WaitForChild("Humanoid")
local lpHRP = lpChar:WaitForChild("HumanoidRootPart")

-- movement vars
local WALK_SPEED = 16
local RUN_EXTRA = 4 -- corrida = WALK_SPEED + RUN_EXTRA por padrão
local speed = WALK_SPEED
local running = false

-- gui + state
