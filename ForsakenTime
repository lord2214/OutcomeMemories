-- Initialize Systems
local function Initialize()
    -- Start server info updates
    task.spawn(function()
        while task.wait(5) do
            ServerInfo:UpdateInfoDisplay()
        end
    end)
    
    -- Setup character added connections
    LocalPlayer.CharacterAdded:Connect(function()
        if States.SpeedBoost.Active then
            task.wait(1) -- Wait for character to load
            PlayerEnhancements:SetupSpeedBoost()
        end
    end)
    
    -- Welcome notification
    Rayfield:Notify({
        Title = "Forsaken Enhanced",
        Content = string.format("Version %s Loaded Successfully!", Config.Version),
        Duration = 6,
        Image = "check-circle"
    })
    
    print(string.format("Forsaken Enhanced %s Initialized", Config.Version))
end

