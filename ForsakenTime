-- Infinite Stamina
local staminaConnection = nil

local function infiniteStaminaLoop()
    -- Desconecta conexão anterior se existir
    if staminaConnection then
        staminaConnection:Disconnect()
        staminaConnection = nil
    end
    
    if state.infiniteStamina then
        -- Método 1: Hook no módulo de Sprint
        task.spawn(function()
            while state.infiniteStamina do
                safeCall(function()
                    local sprintPath = ReplicatedStorage:FindFirstChild("Systems")
                    if sprintPath then
                        sprintPath = sprintPath:FindFirstChild("Character")
                        if sprintPath then
                            sprintPath = sprintPath:FindFirstChild("Game")
                            if sprintPath then
                                sprintPath = sprintPath:FindFirstChild("Sprinting")
                                if sprintPath then
                                    local module = require(sprintPath)
                                    if module then
                                        module.StaminaLossDisabled = true
                                        module.Stamina = 999999
                                        module.MaxStamina = 999999
                                        module.StaminaRegenRate = 999999
                                    end
                                end
                            end
                        end
                    end
                end)
                task.wait(0.05)
            end
        end)
        
        -- Método 2: Força atributos do personagem
        staminaConnection = RunService.Heartbeat:Connect(function()
            if not state.infiniteStamina then return end
            
            safeCall(function()
                local char = LocalPlayer.Character
                if char then
                    local hum = char:FindFirstChild("Humanoid")
                    if hum then
                        -- Força stamina infinita via atributos
                        hum:SetAttribute("Stamina", 100)
                        hum:SetAttribute("MaxStamina", 100)
                        hum:SetAttribute("StaminaEnabled", false)
                        
                        -- Remove debuffs de cansaço
                        if hum:GetAttribute("Exhausted") then
                            hum:SetAttribute("Exhausted", false)
                        end
                        if hum:GetAttribute("Tired") then
                            hum:SetAttribute("Tired", false)
                        end
                    end
                end
            end)
        end)
    else
        -- Restaura valores originais
        safeCall(function()
            local sprintPath = ReplicatedStorage:FindFirstChild("Systems")
            if sprintPath then
                sprintPath = sprintPath:FindFirstChild("Character")
                if sprintPath then
                    sprintPath = sprintPath:FindFirstChild("Game")
                    if sprintPath then
                        sprintPath = sprintPath:FindFirstChild("Sprinting")
                        if sprintPath then
                            local module = require(sprintPath)
                            if module then
                                module.StaminaLossDisabled = false
                                module.Stamina = 100
                                module.MaxStamina = 100
                            end
                        end
                    end
                end
            end
        end)
    end
end

