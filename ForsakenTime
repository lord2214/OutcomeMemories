function ServerInfo:UpdateInfoDisplay()
    local data = self:GetServerData()
    local content = string.format(
        "👥 Players: %d/%d\n🏠 Place ID: %s\n🔧 Job ID: %s\n🎮 Player: %s\n📅 Account Age: %d days",
        data.CurrentPlayers,
        data.MaxPlayers,
        tostring(data.PlaceId),
        data.JobId,
        data.PlayerName,
        data.AccountAge
    )
    
    if InfoParagraph then
        InfoParagraph:Set({
            Title = "📊 Server Information",
            Content = content
        })
    end
end

