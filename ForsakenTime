        end
        
        safeCall(function()
            local char = LocalPlayer.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp and hrp.Anchored then
                    hrp.Anchored = false
                end
            end
        end)
    end))
end

local function autoGeneratorLoop()
    task.spawn(function()
        while state.autoGenerator do
            safeCall(function()
                local map = Workspace.Map.Ingame:FindFirstChild("Map")
                if map then
                    for _, gen in pairs(map:GetChildren()) do
                        if gen:IsA("Model") and gen.Name == "Generator" then
                            local remotes = gen:FindFirstChild("Remotes")
                            if remotes then
                                local re = remotes:FindFirstChild("RE")
                                if re then
                                    re:FireServer()
                                end
                            end
                        end
                    end
                end
            end)
            task.wait(CONFIG.AUTO_GEN_COOLDOWN)
        end
    end)
end

local function autoCoinFlipLoop()
    task.spawn(function()
        while state.autoCoinFlip do
            safeCall(function()
                local remoteEvent = ReplicatedStorage:FindFirstChild("Modules")
                if remoteEvent then
                    remoteEvent = remoteEvent:FindFirstChild("Network")
                    if remoteEvent then
                        remoteEvent = remoteEvent:FindFirstChild("RemoteEvent")
                        if remoteEvent then
                            remoteEvent:FireServer("UseActorAbility", "CoinFlip")
                        end
                    end
                end
            end)
            task.wait(1)
        end
    end)
end

local function fullBrightLoop()
    local connection
    connection = addConnection(RunService.Heartbeat:Connect(function()
        if not state.fullBright then
            Lighting.Brightness = 1
            Lighting.Ambient = Color3.fromRGB(0, 0, 0)
            connection:Disconnect()
            return
        end
        
        safeCall(function()
            Lighting.Brightness = 5
            Lighting.Ambient = Color3.fromRGB(255, 255, 255)
            Lighting.ClockTime = 12
            Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
        end)
    end))
end

local function removeLagLoop()
    task.spawn(function()
        while state.removeLag do
            safeCall(function()
                for _, asset in pairs(Workspace:GetDescendants()) do
                    if (asset:IsA("Part") or asset:IsA("MeshPart")) and asset.Transparency < 1 then
                        if not asset:GetAttribute("OldMaterial") then
                            asset:SetAttribute("OldMaterial", asset.Material.Name)
                        end
                        asset.Material = Enum.Material.SmoothPlastic
                        
                        if asset:IsA("MeshPart") and asset.TextureID ~= "" then
                            if not asset:GetAttribute("OldTextureID") then
                                asset:SetAttribute("OldTextureID", asset.TextureID)
                            end
                            asset.TextureID = ""
                        end
                    end
                end
            end)
            task.wait(0.5) -- Reduzido para melhor performance
        end
        
        -- Restaura materiais originais
        safeCall(function()
            for _, asset in pairs(Workspace:GetDescendants()) do
                if asset:IsA("Part") or asset:IsA("MeshPart") then
                    local oldMat = asset:GetAttribute("OldMaterial")
                    if oldMat then
                        for _, enumItem in ipairs(Enum.Material:GetEnumItems()) do
                            if enumItem.Name == oldMat then
                                asset.Material = enumItem
                                break
                            end
                        end
                    end
                    
                    if asset:IsA("MeshPart") then
                        local oldTex = asset:GetAttribute("OldTextureID")
                        if oldTex then
                            asset.TextureID = oldTex
                        end
                    end
                end
            end
        end)
    end)
end

