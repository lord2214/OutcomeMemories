-- INFINITE STAMINA SYSTEM - REWORKED & APRIMORADO
local staminaModule = nil
local staminaConnection = nil
local staminaInitialized = false

local function getSprintingModule()
    local success, module = pcall(function()
        return require(ReplicatedStorage.Systems.Character.Game.Sprinting)
    end)
    return success and module or nil
end

local function initializeStaminaModule()
    staminaModule = getSprintingModule()
    if staminaModule and not staminaModule.DefaultsSet then
        safeCall(function()
            staminaModule.Init()
        end)
    end
    return staminaModule ~= nil
end

local function applyInfiniteStamina()
    if not staminaModule then
        if not initializeStaminaModule() then
            warn("[FORSAKENED] Módulo de stamina não encontrado")
            return
        end
    end
    
    safeCall(function()
        -- Configurações otimizadas para stamina infinita
        staminaModule.StaminaLoss = 0
        staminaModule.StaminaGain = 999
        staminaModule.MinStamina = 100
        staminaModule.MaxStamina = 100
        staminaModule.Stamina = 100
        staminaModule.StaminaLossDisabled = true
        
        -- Força atualização visual
        if staminaModule.__staminaChangedEvent then
            staminaModule.__staminaChangedEvent:Fire()
        end
    end)
end

local function resetStamina()
    if not staminaModule then return end
    
    safeCall(function()
        staminaModule.StaminaLoss = 10
        staminaModule.StaminaGain = 20
        staminaModule.MinStamina = 0
        staminaModule.MaxStamina = 100
        staminaModule.Stamina = 100
        staminaModule.StaminaLossDisabled = false
        
        if staminaModule.__staminaChangedEvent then
            staminaModule.__staminaChangedEvent:Fire()
        end
    end)
end

local function infiniteStaminaLoop()
    -- Inicializa na primeira vez
    if not staminaInitialized then
        task.wait(1) -- Aguarda o jogo carregar
        initializeStaminaModule()
        staminaInitialized = true
    end
    
    -- Aplica stamina infinita imediatamente
    applyInfiniteStamina()
    
    -- Loop de manutenção contínua
    task.spawn(function()
        while state.infiniteStamina do
            applyInfiniteStamina()
            task.wait(CONFIG.STAMINA_UPDATE_RATE)
        end
        resetStamina()
    end)
    
    -- Listener para respawn do personagem
    if staminaConnection then
        staminaConnection:Disconnect()
    end
    
    staminaConnection = addConnection(LocalPlayer.CharacterAdded:Connect(function()
        if state.infiniteStamina then
            task.wait(1)
            staminaModule = nil -- Força reinicialização
            initializeStaminaModule()
            applyInfiniteStamina()
        end
    end))
end

local function noStunLoop()
