-- Utility Functions
local Utilities = {}

function Utilities.SafeCall(func, ...)
    local success, result = pcall(func, ...)
    if not success then
        warn("Error in SafeCall:", result)
        return nil
    end
    return result
end

function Utilities.GetCharacter(player)
    return Utilities.SafeCall(function()
        return player.Character or player.CharacterAdded:Wait()
    end)
end

function Utilities.GetHumanoid(player)
    local character = Utilities.GetCharacter(player)
    return character and character:FindFirstChildOfClass("Humanoid")
end

function Utilities.GetRootPart(player)
    local character = Utilities.GetCharacter(player)
    return character and (character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart)
end

-- ESP System
local EspManager = {
    Highlights = {},
    Billboards = {}
}

function EspManager:CreateEsp(target, color, text, offsetY)
    if not target or not target.Parent then return end
    
    -- Remove existing ESP
    self:RemoveEsp(target)
    
    -- Create Highlight
    local highlight = Instance.new("Highlight")
    highlight.Name = "ForsakenESP"
    highlight.OutlineColor = color
    highlight.FillColor = color
    highlight.OutlineTransparency = 0
    highlight.FillTransparency = 0.3
    highlight.Parent = target
    highlight.Adornee = target
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    
    self.Highlights[target] = highlight
    
    -- Create Billboard
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ForsakenESP"
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.AlwaysOnTop = true
    billboard.StudsOffset = Vector3.new(0, offsetY or 3, 0)
    billboard.Adornee = target
    billboard.Enabled = true
    billboard.Parent = target
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text or "Unknown"
    label.TextColor3 = color
    label.TextSize = 14
    label.Font = Enum.Font.GothamBold
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.new(0, 0, 0)
    label.Parent = billboard
    
    self.Billboards[target] = billboard
    
    return highlight, billboard
end

function EspManager:RemoveEsp(target)
    if self.Highlights[target] then
        self.Highlights[target]:Destroy()
        self.Highlights[target] = nil
    end
    
    if self.Billboards[target] then
        self.Billboards[target]:Destroy()
        self.Billboards[target] = nil
    end
end

function EspManager:ClearAllEsp()
    for target, highlight in pairs(self.Highlights) do
        highlight:Destroy()
    end
    for target, billboard in pairs(self.Billboards) do
        billboard:Destroy()
    end
    table.clear(self.Highlights)
    table.clear(self.Billboards)
end

-- Player Enhancements
local PlayerEnhancements = {}

function PlayerEnhancements:SetupSpeedBoost()
    if Connections.SpeedBoost then
        Connections.SpeedBoost:Disconnect()
    end
    
    Connections.SpeedBoost = RunService.Heartbeat:Connect(function()
        if not States.SpeedBoost.Active then return end
        
        local humanoid = Utilities.GetHumanoid(LocalPlayer)
        if humanoid then
            humanoid.WalkSpeed = States.SpeedBoost.Value
        end
    end)
end

function PlayerEnhancements:SetupInfiniteStamina()
    if Connections.InfiniteStamina then
        Connections.InfiniteStamina:Disconnect()
    end
    
    Connections.InfiniteStamina = RunService.Heartbeat:Connect(function()
        if not States.InfiniteStamina then return end
        
        -- Multiple methods for maximum compatibility
        local character = Utilities.GetCharacter(LocalPlayer)
        if not character then return end
        
        -- Method 1: Direct value modification
        for _, obj in pairs(character:GetDescendants()) do
            if obj:IsA("NumberValue") or obj:IsA("IntValue") then
                local name = string.lower(obj.Name)
                if name:find("stamina") or name:find("energy") or name:find("tired") or name:find("exhaust") then
                    obj.Value = math.max(obj.Value, 100)
                end
            end
        end
        
        -- Method 2: Humanoid modifications
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            -- Prevent stamina depletion
            if humanoid:GetAttribute("Stamina") then
                humanoid:SetAttribute("Stamina", 100)
            end
        end
    end)
end

function PlayerEnhancements:SetupNoStun()
    if Connections.NoStun then
        Connections.NoStun:Disconnect()
    end
    
    Connections.NoStun = RunService.Heartbeat:Connect(function()
        if not States.NoStun then return end
        
        local character = Utilities.GetCharacter(LocalPlayer)
        if not character then return end
        
        -- Remove stun effects
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Anchored = false
            end
        end
    end)
end

-- ESP Handlers
local EspHandlers = {}

function EspHandlers:HandleSurvivorsEsp()
    if Connections.EspSurvivors then
        Connections.EspSurvivors:Disconnect()
    end
    
    Connections.EspSurvivors = RunService.Heartbeat:Connect(function()
        if not States.EspSurvivors then
            -- Clean up when disabled
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    EspManager:RemoveEsp(player.Character)
                end
            end
            return
        end
        
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local rootPart = Utilities.GetRootPart(player)
                if rootPart then
                    EspManager:CreateEsp(
                        player.Character, 
                        Color3.fromRGB(0, 255, 0), 
                        player.Name .. " (Survivor)",
                        3
                    )
                end
            end
        end
    end)
end

