                    if player:IsA("Model") and player:FindFirstChild("Head") then
                        local username = player:GetAttribute("Username") or "Unknown"
                        createESP(player, Color3.fromRGB(0, 255, 0), player.Name .. " (" .. username .. ")", player.Head, 2)
                    end
                end
            end)
            task.wait(CONFIG.SCAN_RATE)
        end
        clearAllESP()
    end)
end

